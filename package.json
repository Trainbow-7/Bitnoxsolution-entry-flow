{
  "name": "bitnoxsolution-entry-flow",
  "version": "1.0.0",
  "private": true,
  "description": "Bitnoxsolution Visitor Management System (VMS)",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:backend": "cd backend && tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "tunnel": "node tunnel.mjs",
    "start:backend": "cd backend && node dist/server.js",
    "seed": "cd backend && npm run prisma:seed",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build:backend": "cd backend && npm install && npx prisma generate && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.16.0",
    "pdfkit-table": "^0.1.99",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/pdfkit": "^0.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}